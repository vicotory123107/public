using UnityEngine;
using UnityEngine.UI;
using System;
using System.IO.Ports;
using System.Threading;

namespace Tanks.Complete
{
    public class TankShooting : MonoBehaviour
    {
        public Rigidbody m_Shell;
        public Transform m_FireTransform;
        public Slider m_AimSlider;
        public AudioSource m_ShootingAudio;
        public AudioClip m_ChargingClip;
        public AudioClip m_FireClip;

        public float m_MinLaunchForce = 5f;
        public float m_MaxLaunchForce = 20f;
        public float m_MaxChargeTime = 0.75f;
        public float m_ShotCooldown = 0.05f;

        [Header("Player Setup")]
        public int m_PlayerNumber = 1;
        public bool m_IsMicrophoneTank = false;

        [Header("Shell Properties")]
        public float m_MaxDamage = 100f;
        public float m_ExplosionForce = 50f;
        public float m_ExplosionRadius = 5f;

        [Header("ESP32 Serial Settings (Microphone Tank)")]
        public bool m_UseESP32Serial = true;
        public string m_ComPort = "COM8";
        public int m_BaudRate = 115200;

        public float CurrentChargeRatio =>
            (m_CurrentLaunchForce - m_MinLaunchForce) / (m_MaxLaunchForce - m_MinLaunchForce);
        public bool IsCharging => m_IsCharging;
        public bool m_IsComputerControlled { get; set; } = false;

        private float m_CurrentLaunchForce;
        private float m_ChargeSpeed;
        private bool m_Fired;
        private bool m_HasSpecialShell;
        private float m_SpecialShellMultiplier;
        private bool m_IsCharging = false;
        private float m_BaseMinLaunchForce;
        private float m_ShotCooldownTimer;

        // Serial Port for Microphone/ESP32 Tank
        private SerialPort m_SerialPort;
        private Thread m_SerialThread;
        private bool m_IsThreadRunning = false;
        private volatile bool m_TriggerESP32Fire = false;

        private void OnEnable()
        {
            m_CurrentLaunchForce = m_MinLaunchForce;
            m_BaseMinLaunchForce = m_MinLaunchForce;
            if (m_AimSlider != null)
            {
                m_AimSlider.value = m_BaseMinLaunchForce;
                m_AimSlider.minValue = m_MinLaunchForce;
                m_AimSlider.maxValue = m_MaxLaunchForce;
            }
            m_HasSpecialShell = false;
            m_SpecialShellMultiplier = 1.0f;
        }

        private void Start()
        {
            m_ChargeSpeed = (m_MaxLaunchForce - m_MinLaunchForce) / m_MaxChargeTime;

            if (m_IsMicrophoneTank && m_UseESP32Serial)
            {
                OpenSerialConnection();
            }
        }

        private void OpenSerialConnection()
        {
            try
            {
                m_SerialPort = new SerialPort(m_ComPort, m_BaudRate);
                m_SerialPort.ReadTimeout = 25;
                m_SerialPort.WriteTimeout = 25;
                m_SerialPort.Open();

                m_IsThreadRunning = true;
                m_SerialThread = new Thread(ReadSerialLoop);
                m_SerialThread.Start();

                Debug.Log($"[ESP32] Successfully connected to {m_ComPort} at {m_BaudRate} baud for Player {m_PlayerNumber}!");
            }
            catch (Exception e)
            {
                Debug.LogError($"[ESP32] Failed to open {m_ComPort}: {e.Message}");
            }
        }

        private void ReadSerialLoop()
        {
            while (m_IsThreadRunning && m_SerialPort != null && m_SerialPort.IsOpen)
            {
                try
                {
                    string incomingMessage = m_SerialPort.ReadLine().Trim();

                    if (incomingMessage == "FIRE")
                    {
                        m_TriggerESP32Fire = true;
                    }
                }
                catch (TimeoutException) { }
                catch (Exception e)
                {
                    Debug.LogWarning($"[ESP32] Read warning: {e.Message}");
                }
            }
        }

        public void SetLowHealthLED(bool isLowHealth)
        {
            if (m_IsMicrophoneTank && m_SerialPort != null && m_SerialPort.IsOpen)
            {
                try
                {
                    string msg = isLowHealth ? "LED_ON" : "LED_OFF";
                    m_SerialPort.WriteLine(msg);
                }
                catch (Exception e)
                {
                    Debug.LogError($"[ESP32] Error writing to serial: {e.Message}");
                }
            }
        }

        private void Update()
        {
            if (m_IsComputerControlled)
                return;

            if (m_ShotCooldownTimer > 0.0f)
            {
                m_ShotCooldownTimer -= Time.deltaTime;
            }

            if (m_IsMicrophoneTank)
            {
                // Microphone / ESP32 Tank Logic
                if (m_TriggerESP32Fire)
                {
                    m_TriggerESP32Fire = false;
                    TriggerESP32Shot();
                }

                if (m_AimSlider != null)
                {
                    m_AimSlider.value = m_BaseMinLaunchForce;
                }
            }
            else
            {
                // Standard Keyboard Input Tanks (Player 1 uses Space, Player 2 uses Enter)
                HandleKeyboardInput();
            }
        }

        private void HandleKeyboardInput()
        {
            KeyCode fireKey = (m_PlayerNumber == 1) ? KeyCode.Space : KeyCode.Return;

            if (m_AimSlider != null)
            {
                m_AimSlider.value = m_CurrentLaunchForce;
            }

            if (m_CurrentLaunchForce >= m_MaxLaunchForce && !m_Fired)
            {
                m_CurrentLaunchForce = m_MaxLaunchForce;
                Fire();
            }
            else if (Input.GetKeyDown(fireKey))
            {
                m_Fired = false;
                m_CurrentLaunchForce = m_MinLaunchForce;
                m_IsCharging = true;

                if (m_ShootingAudio != null && m_ChargingClip != null)
                {
                    m_ShootingAudio.clip = m_ChargingClip;
                    m_ShootingAudio.Play();
                }
            }
            else if (Input.GetKey(fireKey) && !m_Fired)
            {
                m_CurrentLaunchForce += m_ChargeSpeed * Time.deltaTime;

                if (m_AimSlider != null)
                {
                    m_AimSlider.value = m_CurrentLaunchForce;
                }
            }
            else if (Input.GetKeyUp(fireKey) && !m_Fired)
            {
                m_IsCharging = false;
                Fire();
            }
        }

        private void TriggerESP32Shot()
        {
            if (m_ShotCooldownTimer <= 0)
            {
                m_CurrentLaunchForce = m_MinLaunchForce;
                Fire();
            }
        }

        public void StartCharging()
        {
            m_IsCharging = true;
            m_Fired = false;
            m_CurrentLaunchForce = m_MinLaunchForce;

            if (m_ShootingAudio != null && m_ChargingClip != null)
            {
                m_ShootingAudio.clip = m_ChargingClip;
                m_ShootingAudio.Play();
            }
        }

        public void StopCharging()
        {
            if (m_IsCharging)
            {
                Fire();
                m_IsCharging = false;
            }
        }

        private void Fire()
        {
            m_Fired = true;

            if (m_Shell == null || m_FireTransform == null)
            {
                return;
            }

            Rigidbody shellInstance = Instantiate(m_Shell, m_FireTransform.position, m_FireTransform.rotation) as Rigidbody;
            shellInstance.linearVelocity = m_CurrentLaunchForce * m_FireTransform.forward;

            ShellExplosion explosionData = shellInstance.GetComponent<ShellExplosion>();
            if (explosionData != null)
            {
                explosionData.m_ExplosionForce = m_ExplosionForce;
                explosionData.m_ExplosionRadius = m_ExplosionRadius;
                explosionData.m_MaxDamage = m_MaxDamage;

                if (m_HasSpecialShell)
                {
                    explosionData.m_MaxDamage *= m_SpecialShellMultiplier;
                    m_HasSpecialShell = false;
                    m_SpecialShellMultiplier = 1f;

                    PowerUpDetector powerUpDetector = GetComponent<PowerUpDetector>();
                    if (powerUpDetector != null)
                        powerUpDetector.m_HasActivePowerUp = false;

                    PowerUpHUD powerUpHUD = GetComponentInChildren<PowerUpHUD>();
                    if (powerUpHUD != null)
                        powerUpHUD.DisableActiveHUD();
                }
            }

            if (m_ShootingAudio != null && m_FireClip != null)
            {
                m_ShootingAudio.PlayOneShot(m_FireClip);
            }

            m_CurrentLaunchForce = m_MinLaunchForce;
            m_ShotCooldownTimer = m_ShotCooldown;
            m_Fired = false;
        }

        public void EquipSpecialShell(float damageMultiplier)
        {
            m_HasSpecialShell = true;
            m_SpecialShellMultiplier = damageMultiplier;
        }

        private void OnDestroy()
        {
            if (m_IsMicrophoneTank)
            {
                m_IsThreadRunning = false;

                if (m_SerialThread != null && m_SerialThread.IsAlive)
                {
                    m_SerialThread.Join(50);
                }

                if (m_SerialPort != null && m_SerialPort.IsOpen)
                {
                    try { m_SerialPort.WriteLine("LED_OFF"); } catch { }
                    m_SerialPort.Close();
                }
            }
        }
    }
}
