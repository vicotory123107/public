<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>3D Mini Fortnite - Fixed Controls & Improved Weapons</title>
<style>
    * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; }
    body { background: #000; color: #fff; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; overflow: hidden; width: 100vw; height: 100vh; }
    
    #game-container { position: relative; width: 100%; height: 100%; cursor: pointer; }
    canvas { display: block; width: 100%; height: 100%; }

    /* Crosshair & Hitmarker */
    #crosshair { position: absolute; top: 50%; left: 50%; width: 10px; height: 10px; margin-top: -5px; margin-left: -5px; border: 2px solid rgba(255, 255, 255, 0.8); border-radius: 50%; pointer-events: none; z-index: 2; }
    #hitmarker { position: absolute; top: 50%; left: 50%; width: 20px; height: 20px; margin-top: -10px; margin-left: -10px; pointer-events: none; z-index: 3; opacity: 0; transition: opacity 0.05s ease-out; }
    #hitmarker::before, #hitmarker::after { content: ''; position: absolute; background: #e74c3c; }
    #hitmarker::before { top: 9px; left: 0; width: 20px; height: 2px; }
    #hitmarker::after { top: 0; left: 9px; width: 2px; height: 20px; }
    #hitmarker.headshot::before, #hitmarker.headshot::after { background: #f1c40f; }

    /* Floating Headshot Text */
    #headshot-indicator { position: absolute; top: 42%; left: 50%; transform: translateX(-50%); font-size: 22px; font-weight: bold; color: #f1c40f; text-shadow: 0 0 8px #f39c12, 2px 2px 0px #000; pointer-events: none; z-index: 5; opacity: 0; transition: opacity 0.15s ease-out; }

    /* Sniper Scope Overlay */
    #sniper-scope { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 4; display: none; background: radial-gradient(circle, transparent 30%, rgba(0,0,0,0.95) 70%); }
    #sniper-scope::before { content: ''; position: absolute; top: 50%; left: 0; width: 100%; height: 2px; background: rgba(0,0,0,0.8); }
    #sniper-scope::after { content: ''; position: absolute; top: 0; left: 50%; width: 2px; height: 100%; background: rgba(0,0,0,0.8); }
    
    /* Dynamic Vignette Effect for Slow Motion */
    #slomo-vignette { position: absolute; top: 0; left: 0; width: 100%; height: 100%; box-shadow: inset 0 0 100px rgba(0,229,255,0.6); pointer-events: none; opacity: 0; transition: opacity 0.2s ease; z-index: 4; }
    #slomo-text { position: absolute; top: 20%; left: 50%; transform: translateX(-50%); font-size: 28px; font-weight: bold; color: #00e5ff; text-shadow: 0 0 12px #00e5ff; display: none; z-index: 5; pointer-events: none; letter-spacing: 3px; }

    /* Instructions Overlay for Mouse Lock */
    #click-to-play { position: absolute; top: 15px; left: 50%; transform: translateX(-50%); background: rgba(0,0,0,0.75); border: 1px solid #00e5ff; color: #fff; padding: 8px 18px; border-radius: 20px; font-weight: bold; z-index: 8; pointer-events: none; display: none; }

    /* UI Overlay Screens */
    .screen { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); display: flex; flex-direction: column; justify-content: center; align-items: center; z-index: 10; }
    h1 { font-size: 52px; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 2px; text-shadow: 0 0 15px #00e5ff; }
    p { font-size: 16px; margin-bottom: 20px; color: #ccc; text-align: center; max-width: 600px; line-height: 1.5; }
    
    .input-group { display: flex; gap: 10px; margin-bottom: 20px; }
    input[type="text"] { padding: 12px 16px; font-size: 18px; border-radius: 6px; border: 1px solid #00e5ff; background: #111; color: #fff; outline: none; width: 280px; text-align: center; }
    
    button { padding: 14px 36px; font-size: 20px; font-weight: bold; color: #fff; background: #00e5ff; border: none; border-radius: 6px; cursor: pointer; text-shadow: 0 1px 2px #000; box-shadow: 0 4px 15px rgba(0,229,255,0.4); transition: transform 0.1s, background 0.2s; margin: 5px; }
    button:hover { background: #00b0ff; transform: scale(1.05); }

    /* Map Selector Styling */
    .map-select-container { display: flex; gap: 15px; margin: 15px 0 25px 0; }
    .map-btn { padding: 10px 20px; font-size: 16px; background: rgba(255,255,255,0.1); border: 2px solid #555; color: #aaa; box-shadow: none; border-radius: 6px; cursor: pointer; transition: all 0.2s; }
    .map-btn.active { border-color: #00e5ff; color: #fff; background: rgba(0,229,255,0.25); text-shadow: 0 0 8px #00e5ff; }

    /* Lobby Details */
    #lobby-status { background: rgba(255,255,255,0.05); padding: 20px; border-radius: 8px; border: 1px solid rgba(0,229,255,0.3); margin-bottom: 20px; width: 420px; text-align: center; }
    .status-text { font-size: 18px; color: #2ecc71; font-weight: bold; margin-top: 10px; }
    .room-id-box { background: #111; border: 2px dashed #00e5ff; padding: 12px; margin: 15px 0; border-radius: 6px; font-size: 18px; color: #f1c40f; word-break: break-all; user-select: text; }

    /* HUD */
    #hud { position: absolute; bottom: 25px; left: 25px; z-index: 5; display: flex; flex-direction: column; gap: 8px; width: 260px; background: rgba(0,0,0,0.6); padding: 14px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2); pointer-events: none; }
    .bar-container { width: 100%; background: #222; height: 20px; border-radius: 10px; overflow: hidden; border: 1px solid #444; position: relative; }
    .bar-fill { height: 100%; transition: width 0.15s ease-out; }
    #shield-bar { background: #00e5ff; width: 0%; }
    #health-bar { background: #2ecc71; width: 100%; }
    .bar-text { position: absolute; top: 0; left: 0; width: 100%; height: 100%; font-size: 12px; font-weight: bold; display: flex; align-items: center; justify-content: center; text-shadow: 1px 1px 2px #000; }
    #weapon-display { margin-top: 5px; font-size: 14px; font-weight: bold; color: #f1c40f; text-align: center; }
    #consumable-display { font-size: 13px; font-weight: bold; color: #2ecc71; text-align: center; margin-top: 2px; }

    #info-panel { position: absolute; top: 25px; right: 25px; z-index: 5; background: rgba(0,0,0,0.6); padding: 12px 18px; border-radius: 8px; font-weight: bold; border: 1px solid rgba(255,255,255,0.2); pointer-events: none; text-align: right; }
    #prompt { position: absolute; top: 60%; left: 50%; transform: translate(-50%, -50%); font-size: 20px; font-weight: bold; color: #f1c40f; text-shadow: 2px 2px 4px #000; display: none; z-index: 5; }
    #use-progress { position: absolute; top: 65%; left: 50%; transform: translate(-50%, -50%); font-size: 18px; font-weight: bold; color: #2ecc71; text-shadow: 2px 2px 4px #000; display: none; z-index: 5; }
    #build-mode { position: absolute; bottom: 25px; right: 25px; z-index: 5; background: rgba(0,0,0,0.6); padding: 10px 15px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2); pointer-events: none; color: #00e5ff; font-weight: bold; }
    #bus-prompt { position: absolute; top: 30%; left: 50%; transform: translateX(-50%); font-size: 24px; font-weight: bold; color: #f1c40f; background: rgba(0,0,0,0.7); padding: 12px 24px; border-radius: 8px; border: 2px solid #f1c40f; z-index: 6; pointer-events: none; display: none; text-align: center; }
</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
